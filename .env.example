# Copy to .env; generate unique local values for all required passwords.
# Simple KEY=VALUE syntax only: no quotes, interpolation, or inline comments.
POSTGRES_DB=pairforge
POSTGRES_USER=pairforge
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
WORKER_DB_USER=pairforge_worker
WORKER_DB_PASSWORD=
# API only: 32 random bytes encoded as 64 hex characters. Never a frontend VITE_ variable.
JWT_KEY_HEX=
REDIS_PORT=6379
RABBITMQ_USER=pairforge
RABBITMQ_PASSWORD=
RABBITMQ_PORT=5672
API_PORT=8080
API_MANAGEMENT_PORT=8082
WORKER_MANAGEMENT_PORT=8083
WORKER_PORT=8081
FRONTEND_PORT=5173
